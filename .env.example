# Copia este archivo como .env y llénalo. El .env nunca va a git.
# PORT lo pone UVLIS (Código) al iniciar el servicio.

# Base de datos MySQL propia del proyecto
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=farmaradar
DB_USER=farmaradar
DB_PASSWORD=

# Dirección pública (para los enlaces que se mandan por WhatsApp)
URL_PUBLICA=https://farmaradar.lat

# Acceso inicial al panel del equipo (se usa solo la primera vez que arranca)
ADMIN_USUARIO=admin
ADMIN_CLAVE_INICIAL=

# Clave que deben mandar n8n y el agente de voz al avisar (cabecera X-FarmaRadar-Secreto)
WEBHOOK_SECRETO=

# ── APIs (vacías = pendientes; el sistema funciona sin ellas y las usa en cuanto se ponen) ──
# Fase 1 · Firecrawl: precios y existencias de las cadenas
FIRECRAWL_API_KEY=
# Fase 2 · ElevenLabs: llamada de voz al boticario
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
# Tope de llamadas por día (cuestan dinero)
LLAMADAS_POR_DIA=20
# Fase 2 · n8n: alertas por WhatsApp (webhook de entrada de n8n)
N8N_WEBHOOK_URL=
# Gemma 4: principio activo y genéricos (cualquier API compatible con OpenAI: Ollama, OpenRouter, vLLM…)
GEMMA_URL=
GEMMA_API_KEY=
GEMMA_MODELO=
# MojoAuth: entrar sin contraseña
MOJOAUTH_API_KEY=
